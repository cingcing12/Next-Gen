CREATE req.body: {"name":"VIBRANT LEATHER + OUD VIBRANT LEATHER EDP","description":"Vibrant Leather EDPThe Vibe: Bright, clean, and highly energetic. This fragrance is widely famous in the perfume community for capturing a high-end luxury vibe at an affordable price.The Scent Journey: It opens with a very sharp, juicy blast of fresh bergamot and lemon. As it settles, a unique note of bamboo keeps it smelling crisp and green. The dry down is a very soft, clean leather and earthy patchouli. It smells like a fresh luxury leather jacket sprayed with expensive citrus.The Experience: It is highly mass-pleasing, safe for the office, and gets a lot of compliments, though it requires re-spraying after a few hours.","price":0,"discount":0,"stock":20,"category":"Kids","subCategory":"Perfumes","sizes":["60ML","120ML"],"colors":["Default"],"colorVariants":[{"color":"Default","image":"","images":[],"sizeVariants":[{"size":"60ML","stock":10,"price":50,"images":["https://res.cloudinary.com/ac2ibth5/image/upload/v1790584115/next-gen/oyhhq383rsalm1yjbrb3.jpg","https://res.cloudinary.com/ac2ibth5/image/upload/v1790584141/next-gen/udkmxzk4ddgpr6vyuj7q.jpg"]},{"size":"120ML","stock":10,"price":70,"images":["https://res.cloudinary.com/ac2ibth5/image/upload/v1790584208/next-gen/rnb5vi7ottgpbbjllbya.jpg","https://res.cloudinary.com/ac2ibth5/image/upload/v1790584208/next-gen/kz3qf03ddxvmom4x0yf3.jpg"]}]}],"images":["https://res.cloudinary.com/ac2ibth5/image/upload/v1790584115/next-gen/oyhhq383rsalm1yjbrb3.jpg","https://res.cloudinary.com/ac2ibth5/image/upload/v1790584141/next-gen/udkmxzk4ddgpr6vyuj7q.jpg","https://res.cloudinary.com/ac2ibth5/image/upload/v1790584208/next-gen/rnb5vi7ottgpbbjllbya.jpg","https://res.cloudinary.com/ac2ibth5/image/upload/v1790584208/next-gen/kz3qf03ddxvmom4x0yf3.jpg"]}
CREATE product before save: {"name":"VIBRANT LEATHER + OUD VIBRANT LEATHER EDP","description":"Vibrant Leather EDPThe Vibe: Bright, clean, and highly energetic. This fragrance is widely famous in the perfume community for capturing a high-end luxury vibe at an affordable price.The Scent Journey: It opens with a very sharp, juicy blast of fresh bergamot and lemon. As it settles, a unique note of bamboo keeps it smelling crisp and green. The dry down is a very soft, clean leather and earthy patchouli. It smells like a fresh luxury leather jacket sprayed with expensive citrus.The Experience: It is highly mass-pleasing, safe for the office, and gets a lot of compliments, though it requires re-spraying after a few hours.","images":["https://res.cloudinary.com/ac2ibth5/image/upload/v1790584115/next-gen/oyhhq383rsalm1yjbrb3.jpg","https://res.cloudinary.com/ac2ibth5/image/upload/v1790584141/next-gen/udkmxzk4ddgpr6vyuj7q.jpg","https://res.cloudinary.com/ac2ibth5/image/upload/v1790584208/next-gen/rnb5vi7ottgpbbjllbya.jpg","https://res.cloudinary.com/ac2ibth5/image/upload/v1790584208/next-gen/kz3qf03ddxvmom4x0yf3.jpg"],"category":"Kids","subCategory":"Perfumes","price":0,"discount":0,"stock":20,"sizes":["60ML","120ML"],"colors":["Default"],"colorVariants":[{"color":"Default","image":"","images":[],"sizeVariants":[{"size":"60ML","stock":10,"price":50,"images":["https://res.cloudinary.com/ac2ibth5/image/upload/v1790584115/next-gen/oyhhq383rsalm1yjbrb3.jpg","https://res.cloudinary.com/ac2ibth5/image/upload/v1790584141/next-gen/udkmxzk4ddgpr6vyuj7q.jpg"],"_id":"6aba25c42053226da2ac0c1d"},{"size":"120ML","stock":10,"price":70,"images":["https://res.cloudinary.com/ac2ibth5/image/upload/v1790584208/next-gen/rnb5vi7ottgpbbjllbya.jpg","https://res.cloudinary.com/ac2ibth5/image/upload/v1790584208/next-gen/kz3qf03ddxvmom4x0yf3.jpg"],"_id":"6aba25c42053226da2ac0c1e"}],"_id":"6aba25c42053226da2ac0c1c"}],"rating":0,"numReviews":0,"likes":0,"isPublished":true,"cartCount":0,"wishlistCount":0,